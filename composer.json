{
    "name": "browsersolver/sdk",
    "description": "Official PHP SDK for the BrowserSolver web unlocker API.",
    "type": "library",
    "keywords": [
        "antibot",
        "api",
        "browsersolver",
        "headless-browser",
        "sdk",
        "web-scraping",
        "web-unlocker"
    ],
    "homepage": "https://www.browsersolver.com",
    "license": "MIT",
    "authors": [
        {
            "name": "BrowserSolver",
            "email": "contact@browsersolver.com"
        }
    ],
    "support": {
        "issues": "https://github.com/browsersolver/browsersolver-php/issues",
        "source": "https://github.com/browsersolver/browsersolver-php",
        "docs": "https://app.browsersolver.com/openapi"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "BrowserSolver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrowserSolver\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "test": "phpunit --configuration=phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
